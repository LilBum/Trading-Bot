# ============================================================
#  Trading Bot — Environment Variables
# ============================================================
#
#  Copy this file to .env, then fill in only the credentials
#  you have. Leave the rest blank — providers fail closed when
#  their key is empty.
#
#  .env is gitignored. Never commit it.
#  The startup loader will REFUSE to run if it finds plaintext
#  credentials in config.json. Put them here instead.
#
#  Rotation: issue a new key in the provider portal, update
#  this file, restart the bot, then revoke the old key.
#
# ============================================================


# ----- Webull OpenAPI ---------------------------------------
# Portal:    https://developer.webull.com/
# Discover:  py -m src --list-paper-accounts

# Live trading. Leave empty until live deployment is approved.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=

# Paper / sandbox. Required for paper-mode end-to-end testing.
WEBULL_TEST_APP_KEY=
WEBULL_TEST_APP_SECRET=

# Account IDs — one per environment.
WEBULL_PAPER_ACCOUNT_ID=
WEBULL_LIVE_ACCOUNT_ID=
# Fallback when neither *_PAPER_* nor *_LIVE_* is set.
# WEBULL_ACCOUNT_ID=


# ----- Tradier (data + execution) ---------------------------
# Portal:    https://documentation.tradier.com/

TRADIER_ACCESS_TOKEN=
TRADIER_SANDBOX_TOKEN=
TRADIER_ACCOUNT_ID=


# ----- Public.com (options chain) ---------------------------
# Portal:    Account settings → API access (personal token)

PUBLIC_SECRET_TOKEN=
PUBLIC_ACCOUNT_ID=


# ----- Finnhub (intraday bars fallback) ---------------------
# Portal:    https://finnhub.io/  (free tier sufficient for now)

FINNHUB_API_KEY=


# ----- Massive (primary intraday bars; formerly Polygon.io) -
# Portal:    https://massive.com/   (free tier: no card, 5 req/min, ~2yr)
# Used by:   live runs (src/data/massive.py) AND
#            scripts/download_historical.py for backtest data

MASSIVE_API_KEY=
# Optional overrides for the historical downloader / live client:
# MASSIVE_BASE_URL=https://api.massive.com
# MASSIVE_AUTH_MODE=query          # or 'header' for Authorization: Bearer


# ----- Databento (CME futures historical bars) --------------
# Portal:    https://databento.com   ($125 signup credit; ohlcv-1m schema is cheap)
# Used by:   scripts/download_futures_databento.py for ES/NQ backtest data

DATABENTO_API_KEY=
